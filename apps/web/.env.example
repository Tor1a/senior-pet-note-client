# Java 백엔드 API 주소
# 이 파일을 .env.local 로 복사해서 쓰세요. .env.local 은 git 에 올라가지 않습니다.
# 비워 두면 기본값 http://localhost:8080 을 씁니다. 끝에 / 는 붙이지 않아도 됩니다.
# 비밀 값(토큰·비밀번호)은 넣지 마세요. VITE_ 로 시작하는 값은 브라우저에 그대로 공개됩니다.
VITE_API_BASE_URL=http://localhost:8080

# ---- 투약 알림(웹 푸시, Firebase Cloud Messaging) ----
# 다섯 개를 모두 채워야 알림이 켜집니다. 하나라도 비어 있으면 알림 기능만 꺼지고 앱은 그대로 동작합니다.
# 값은 Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹 앱) 에서 복사합니다.
# 백엔드(senior-pet-note-api)의 FCM 서비스 계정과 "같은 Firebase 프로젝트"여야 합니다.
# 이 값들은 공개를 전제로 한 식별값이지만, 실제 값은 .env.local 에만 적으세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서의 "공개 키"(키 쌍). 개인 키는 절대 넣지 마세요.
VITE_FIREBASE_VAPID_KEY=

# 개인정보 처리방침 주소 (http/https). 비워 두면 계정·회원 탈퇴 화면의 링크 줄이 통째로 숨겨집니다.
# 스토어 심사 전에는 반드시 채우세요. 비밀 값이 아닙니다.
VITE_PRIVACY_POLICY_URL=

# ---- 계정 삭제 안내 페이지(/delete-account, 로그인 없이 열림. Google Play "앱 밖 삭제 요청 링크"로 쓸 수 있음) ----
# 값이 비어 있으면 해당 줄이 화면에서 숨겨집니다. 모두 공개되는 값이니 비밀 값은 넣지 마세요.
# 문의 이메일(삭제 요청을 받을 주소). 비었거나 형식이 틀리면 빌드할 때 경고가 나옵니다. 스토어 제출 전 필수
VITE_SUPPORT_EMAIL=
# 이메일 요청 줄에 덧붙일 처리 기간·본인 확인 안내 (사실만. 코드에 기본 문구가 없으니 정해진 뒤에 적으세요)
VITE_DELETE_REQUEST_NOTE=
# 개발자·운영자 이름
VITE_OPERATOR_NAME=
# 백업·서버 로그의 보관 기간 등 한 문장 안내 (정해진 뒤에 적으세요)
VITE_RETENTION_NOTE=
