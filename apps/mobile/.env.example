# 시니어펫 노트 모바일 환경변수 예시
# 사용법: 이 파일을 .env 로 복사해 값을 고친 뒤 `npx expo start` 를 다시 실행하세요. (.env 는 git 에 올리지 않습니다)
# EXPO_PUBLIC_ 로 시작하는 값은 앱 번들에 그대로 들어갑니다. 비밀번호·API 키 같은 비밀값은 절대 넣지 마세요.

# Java 백엔드 API 주소 (끝에 / 없이)
# - 안드로이드 에뮬레이터: http://10.0.2.2:8080   (에뮬레이터 안에서 PC 의 localhost 를 가리키는 특수 주소)
# - iOS 시뮬레이터·웹:     http://localhost:8080
# - 실기기(Expo Go):       PC 의 LAN IP 를 쓰세요. 예: http://192.168.0.10:8080
#   (PC 에서 `ipconfig` 로 IPv4 주소 확인. 휴대폰과 PC 가 같은 Wi-Fi 여야 하고, Windows 방화벽에서 8080 포트를 허용해야 할 수 있음)
# - 비워 두면 안드로이드는 10.0.2.2:8080, 그 외는 localhost:8080 을 씁니다.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# 개인정보 처리방침 주소 (http/https). 비워 두면 계정·회원 탈퇴 화면의 링크 줄이 통째로 숨겨집니다.
# 스토어 심사 전에는 반드시 채우세요. 비밀 값이 아닙니다.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
